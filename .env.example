# Configurações do Servidor SMTP (Corporativo, Outlook, etc.)
EMAIL_HOST=smtp.seudominio.com.br
EMAIL_PORT=587
EMAIL_HOST_USER=usuario@seudominio.com.br
EMAIL_HOST_PASSWORD=sua_senha_aqui
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Endereço de remetente (From:) - útil se o servidor SMTP corporativo exigir um remetente específico
EMAIL_FROM=remetente_autorizado@seudominio.com.br

# E-mail que receberá os relatórios
EMAIL_DESTINATARIO=destinatario@dominio.com.br
