# Normaliza todas as quebras de linha para LF no repositório (cross-platform)
* text=auto eol=lf

# Scripts Python e de configuração — sempre LF
*.py        text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.env       text eol=lf
*.example   text eol=lf
*.sh        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.cfg       text eol=lf
*.ini       text eol=lf
*.toml      text eol=lf

# Scripts Windows — mantém CRLF (exigido pelo cmd/PowerShell)
*.bat       text eol=crlf
*.ps1       text eol=crlf
*.cmd       text eol=crlf

# Binários — sem conversão
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pdf       binary
